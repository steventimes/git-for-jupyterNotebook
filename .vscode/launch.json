{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Notebook Git Gutter",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/src/**/*.js"],
      "preLaunchTask": "npm: compile"
    },
    {
      "name": "Native Notebook decoration probe",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/probe", "${workspaceFolder}/demo/demo.ipynb"],
      "outFiles": ["${workspaceFolder}/out/probe/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
